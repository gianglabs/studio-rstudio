{
  "$defs": {
    "studio_options": {
      "title": "RStudio Studio Options",
      "type": "object",
      "description": "Configuration for RStudio Server container",
      "properties": {
        "r_version": {
          "type": "string",
          "default": "4.4.2",
          "description": "R version for the RStudio Server container (e.g. 4.4.2, 4.3.3).",
          "fa_icon": "fas fa-code-branch"
        },
        "image": {
          "type": "string",
          "default": "",
          "format": "file-path",
          "description": "Path to pre-cached Docker image tar.zst file. If empty, pulls from Docker Hub.",
          "fa_icon": "fas fa-database"
        },
        "snapshot": {
          "type": "boolean",
          "default": false,
          "description": "If true, save the running container state as a zstd-compressed tar file when the job stops.",
          "fa_icon": "fas fa-camera"
        },
        "outdir": {
          "type": "string",
          "default": "s3://${workspace_id}/data/images/podman/rstudio",
          "format": "directory-path",
          "description": "S3 path to save snapshot tar files.",
          "fa_icon": "fas fa-folder"
        }
      }
    }
  }
}
